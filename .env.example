NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://attendesk:change-me@localhost:5432/attendesk
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_SIZE=12
AUTH_SECRET=replace-with-at-least-32-random-bytes
OTP_SECRET=replace-with-another-32-random-bytes
BARCODE_PEPPER=replace-with-a-third-32-random-value
COLLEGE_NAME=Your College
COLLEGE_EMAIL_DOMAIN=college.edu
COLLEGE_TIMEZONE=Asia/Kolkata
ATTENDANCE_THRESHOLD=75
ADMIN_EMAIL=admin@college.edu
ADMIN_NAME=Main Administrator
RESEND_API_KEY=
EMAIL_FROM=AttenDesk <attendance@college.edu>
MIN_RSSI=-92
ENFORCE_TIMETABLE=false
TIMETABLE_GRACE_MINUTES=10
BACKUP_DIRECTORY=/var/attendesk-backups
BACKUP_RETENTION_DAYS=30
BACKUP_S3_URI=
