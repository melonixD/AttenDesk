# ---------------------------------------------------------------------------
# AttenDesk — Harcourt Butler Technical University
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8787

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://attendesk:change-me@localhost:5432/attendesk
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_SIZE=12

# --- Secrets: generate each one separately with `openssl rand -base64 48` ---
# They must be different from one another and at least 32 characters.
AUTH_SECRET=replace-with-at-least-32-random-bytes
OTP_SECRET=replace-with-another-32-random-bytes
BARCODE_PEPPER=replace-with-a-third-32-random-value

# --- College ---------------------------------------------------------------
COLLEGE_NAME=Harcourt Butler Technical University
COLLEGE_EMAIL_DOMAIN=hbtu.ac.in
COLLEGE_TIMEZONE=Asia/Kolkata
ATTENDANCE_THRESHOLD=75
ACADEMIC_YEAR=2025-26
ADMIN_EMAIL=melonix@hbtu.ac.in
ADMIN_NAME=Akshat Shukla

# --- Attendance rules ------------------------------------------------------
# Teachers at HBTU may start unscheduled sessions, so this stays false.
ENFORCE_TIMETABLE=false
TIMETABLE_GRACE_MINUTES=10
# Set true once every room is in the classroom registry.
REQUIRE_REGISTERED_CLASSROOM=false
# Native-app students only; Web Bluetooth exposes no RSSI. Measure on campus.
MIN_RSSI=-92
# A beacon that has not polled within this many seconds shows as offline.
BEACON_OFFLINE_SECONDS=45
# Set true to require a password from students as well as name + roll number.
STUDENT_REQUIRE_PASSWORD=false

# --- Seed passwords (used only by `npm run seed:hbtu`) ---------------------
# Change these before seeding, and change them again from inside the app.
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=
SEED_ROOMS=210,211,212
SEED_BUILDING=Main Academic Block

# --- Email (OTP fallback login) -------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=AttenDesk <attendance@hbtu.ac.in>

# --- Backups ---------------------------------------------------------------
BACKUP_DIRECTORY=/var/attendesk-backups
BACKUP_RETENTION_DAYS=30
BACKUP_S3_URI=
